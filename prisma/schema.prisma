  photoUrl   String?
  email      String?
  phone      String?
  linkedin   String?
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("site_team_members")
}

// ============================
// MEDIA MANAGER
// ============================

model MediaFile {

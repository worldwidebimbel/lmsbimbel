generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // url: connection pooler (PgBouncer/Supabase port 6543) — dipakai PrismaClient runtime
  // directUrl: direct connection (port 5432) — dipakai Prisma CLI (migrate deploy, db push, studio)
  // Untuk PostgreSQL lokal tanpa pooler (mis. digsan.study), isi DIRECT_URL = DATABASE_URL
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================
// ENUMS
// ============================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ADMIN_CABANG
  ADMIN_KEUANGAN
  ADMIN_AKADEMIK
  GURU
  SISWA
  ORANG_TUA
  AFILIATOR
}

enum ClassType {
  REGULER
  PRIVAT
  ONLINE
}

enum ScheduleDay {
  SENIN
  SELASA
  RABU
  KAMIS
  JUMAT
  SABTU
  MINGGU
}

enum MaterialType {
  PDF
  VIDEO
  YOUTUBE
  PRESENTATION
  DOCUMENT
  LINK
  TEXT
}

enum QuestionType {
  PILGAN
  PILGAN_KOMPLEK
  BENAR_SALAH
  MENJODOHKAN
  MENGURUTKAN
  SETUJU_TIDAK
  ESSAY
  ISIAN
}

enum AttendanceStatus {
  HADIR
  SAKIT
  IZIN
  ALPHA
}

enum StimulusType {
  AUDIO
  READING
}

enum InvoiceStatus {
  UNPAID
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  TRANSFER
  CASH
  QRIS
  MIDTRANS
  XENDIT
  DUITKU
}

enum FeatureTier {
  BASIC
  STANDARD
  PREMIUM
}

enum NotifType {
  INFO
  SUCCESS
  WARNING
  ERROR
  PAYMENT
  ATTENDANCE
  GRADE
  ASSIGNMENT
  EXAM
  PPDB
  AFFILIATE
}

enum StudentStatus {
  AKTIF
  TUNGGAKAN
  NONAKTIF
  LULUS
  BERHENTI
}

// ============================
// FEATURE FLAGS
// ============================

model FeatureFlag {
  id           String      @id @default(cuid())
  code         String      @unique
  name         String
  description  String
  isActive     Boolean     @default(false)
  tier         FeatureTier @default(BASIC)
  category     String      @default("general")
  icon         String?
  affectedRoles String[]
  sortOrder    Int         @default(0)
  modifiedBy   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("feature_flags")
}

// ============================
// PERMISSIONS (Tahap 4.1)
// ============================

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  module      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id             String   @id @default(cuid())
  role           UserRole
  permissionCode String
  createdAt      DateTime @default(now())

  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@unique([role, permissionCode])
  @@map("role_permissions")
}

// ============================
// BRANCHES
// ============================

model Branch {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  address     String?
  phone       String?
  email       String?
  managerName String?
  isActive    Boolean   @default(true)
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users        User[]
  classes      Class[]
  invoices     Invoice[]
  transactions BranchTransaction[]
  transfersFrom BranchCashTransfer[] @relation("TransferFrom")
  transfersTo   BranchCashTransfer[] @relation("TransferTo")
  events       Event[]
  academicCalendarEvents AcademicCalendar[]
  programs     Program[]
  buildings    Building[]
  rooms        Room[]
  registrations Registration[]
  teacherAttendances TeacherAttendance[]
  teacherPayrolls    TeacherPayroll[]
  teachingJournals   TeachingJournal[]
  raports            Raport[]

  @@map("branches")
}

// USERS & AUTH
// ============================

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  password         String?
  role             UserRole  @default(SISWA)
  avatar           String?
  isActive         Boolean   @default(true)
  emailVerified    DateTime?
  defaultBranchId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  profile       UserProfile?
  accounts      Account[]
  sessions      Session[]
  defaultBranch Branch?      @relation(fields: [defaultBranchId], references: [id])

  taughtClasses    Class[]      @relation("TeacherClasses")
  enrolledClasses  ClassStudent[]
  materials        Material[]
  assignments      Assignment[]
  submissions      Submission[]
  examAttempts     ExamAttempt[]
  attendanceRecords AttendanceRecord[]
  grades           Grade[]
  invoices         Invoice[]
  payments         Payment[]
  notifications    Notification[]
  sentAnnouncements Announcement[]
  studentBadges    StudentBadge[]
  studentPoints    StudentPoints?
  children         ParentChild[]  @relation("ParentRelation")
  parents          ParentChild[]  @relation("ChildRelation")
  featureFlagLogs  FeatureFlagLog[]
  forumThreads     ForumThread[]
  forumReplies     ForumReply[]
  forumUpvotes     ForumUpvote[]
  sentMessages     Message[]     @relation("SentMessages")
  receivedMessages Message[]     @relation("ReceivedMessages")
  liveSessions     LiveSession[] @relation("TeacherLiveSessions")
  schedules        Schedule[]     @relation("ScheduleTeacher")
  auditLogs        AuditLog[]
  affiliate        Affiliate?
  branchTransactions BranchTransaction[]
  requestedTransfers BranchCashTransfer[]
  createdEvents    Event[]
  eventRegistrations EventRegistration[]
  certificates       Certificate[]
  mediaFiles         MediaFile[]
  academicCalendarEvents AcademicCalendar[]
  teacherAttendances TeacherAttendance[]
  teacherPayrolls    TeacherPayroll[]
  teachingJournals   TeachingJournal[]
  raports            Raport[]
  approvedPayrolls   TeacherPayroll[] @relation("ApprovedPayrolls")
  verifiedAttendances TeacherAttendance[] @relation("AttendanceVerifier")
  notificationLogs   NotificationLog[]

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}

model UserProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  phone             String?
  address           String?
  birthDate         DateTime?
  birthPlace        String?
  gender            String?
  religion          String?
  nationality       String?
  nisn              String?
  nik               String?
  schoolName        String?
  gradeLevel        String?
  educationHistory  Json?     @default("[]")
  parentName        String?
  parentPhone       String?
  bio               String?
  bloodType         String?
  hobbies           String?
  emergencyContact  Json?     @default("{}")
  socialLinks       Json?     @default("{}")
  profileComplete   Boolean   @default(false)
  studentStatus     StudentStatus @default(AKTIF)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model ParentChild {
  parentId  String
  childId   String
  createdAt DateTime @default(now())

  parent    User     @relation("ParentRelation", fields: [parentId], references: [id])
  child     User     @relation("ChildRelation", fields: [childId], references: [id])

  @@id([parentId, childId])
  @@map("parent_children")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ============================
// AKADEMIK
// ============================

model Subject {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  color       String   @default("#3B82F6")
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classes     Class[]
  materials   Material[]
  questions   Question[]
  forumThreads ForumThread[]

  @@map("subjects")
}

model Class {
  id          String    @id @default(cuid())
  name        String
  description String?
  subjectId   String
  teacherId   String
  branchId    String?
  type        ClassType @default(REGULER)
  maxStudents Int       @default(30)
  roomId      String?
  programId   String?
  levelId     String?
  academicYearId String?
  isActive    Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  subject     Subject   @relation(fields: [subjectId], references: [id])
  teacher     User      @relation("TeacherClasses", fields: [teacherId], references: [id])
  branch      Branch?   @relation(fields: [branchId], references: [id])
  roomRel     Room?     @relation(fields: [roomId], references: [id])
  program     Program?  @relation(fields: [programId], references: [id])
  level       Level?    @relation(fields: [levelId], references: [id])
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])
  students    ClassStudent[]
  schedules   Schedule[]
  materials   Material[]
  assignments Assignment[]
  exams       Exam[]
  attendances Attendance[]
  gradeComponents GradeComponent[]
  forumThreads ForumThread[]
  liveSessions LiveSession[]
  teacherAttendances TeacherAttendance[]
  teachingJournals  TeachingJournal[]
  raports           Raport[]

  @@map("classes")
  @@index([branchId])
  @@index([programId])
}

model ClassStudent {
  classId    String
  studentId  String
  enrolledAt DateTime @default(now())

  class      Class    @relation(fields: [classId], references: [id])
  student    User     @relation(fields: [studentId], references: [id])

  @@id([classId, studentId])
  @@map("class_students")
}

model Schedule {
  id             String      @id @default(cuid())
  classId        String
  dayOfWeek      ScheduleDay
  startTime      String
  endTime        String
  roomId         String?
  teacherId      String?
  isRecurring    Boolean     @default(true)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  class          Class       @relation(fields: [classId], references: [id])
  roomRel        Room?       @relation(fields: [roomId], references: [id])
  teacher        User?       @relation("ScheduleTeacher", fields: [teacherId], references: [id])
  attendances    Attendance[]
  exceptions     ScheduleException[]
  teacherAttendances TeacherAttendance[]
  teachingJournals   TeachingJournal[]

  @@map("schedules")
  @@index([roomId])
  @@index([teacherId])
}

model ScheduleException {
  id              String   @id @default(cuid())
  scheduleId      String
  date            DateTime
  reason          String?
  replacementDate DateTime?
  createdAt       DateTime @default(now())

  schedule        Schedule @relation(fields: [scheduleId], references: [id])

  @@map("schedule_exceptions")
}

model TeachingJournal {
  id          String   @id @default(cuid())
  classId     String
  teacherId   String
  scheduleId  String?
  branchId    String?
  sessionDate DateTime
  startTime   String
  endTime     String
  material    String?
  activity    String
  obstacles   String?
  solution    String?
  studentCount Int    @default(0)
  status      String  @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class       Class   @relation(fields: [classId], references: [id])
  teacher     User    @relation(fields: [teacherId], references: [id])
  schedule    Schedule? @relation(fields: [scheduleId], references: [id])
  branch      Branch?  @relation(fields: [branchId], references: [id])

  @@map("teaching_journals")
  @@index([classId])
  @@index([teacherId])
  @@index([branchId])
}

enum CalendarEventType {
  LIBURAN
  UJIAN
  TRYOUT
  RAPAT
  EVENT
  PENTING
  LAINNYA
}

model AcademicCalendar {
  id          String           @id @default(cuid())
  branchId    String?
  title       String
  description String?
  type        CalendarEventType @default(LAINNYA)
  startDate   DateTime
  endDate     DateTime?
  isAllDay    Boolean          @default(true)
  color       String?
  isActive    Boolean          @default(true)
  createdBy   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  branch      Branch?          @relation(fields: [branchId], references: [id])
  creator     User             @relation(fields: [createdBy], references: [id])

  @@map("academic_calendar")
  @@index([branchId])
  @@index([startDate])
}

// ============================
// MATERI PEMBELAJARAN
// ============================

model Material {
  id           String       @id @default(cuid())
  title        String
  description  String?
  classId      String?
  subjectId    String?
  uploaderId   String
  type         MaterialType @default(PDF)
  fileUrl      String?
  fileSize     Int?
  duration     Int?
  order        Int          @default(0)
  isPublished  Boolean      @default(false)
  chapterTitle String?
  chapterOrder Int          @default(0)
  content      String?      @db.Text
  keyPoints    Json?
  tips         String?      @db.Text
  slideCount   Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  class       Class?       @relation(fields: [classId], references: [id])
  subject     Subject?     @relation(fields: [subjectId], references: [id])
  uploader    User         @relation(fields: [uploaderId], references: [id])
  progress    MaterialProgress[]
  exams       Exam[]

  @@map("materials")
}

model MaterialProgress {
  materialId  String
  studentId   String
  isCompleted Boolean  @default(false)
  completedAt DateTime?
  lastViewedAt DateTime?

  material    Material @relation(fields: [materialId], references: [id])

  @@id([materialId, studentId])
  @@map("material_progress")
}

// ============================
// TUGAS
// ============================

model Assignment {
  id          String    @id @default(cuid())
  title       String
  description String?
  classId     String
  teacherId   String
  dueDate     DateTime
  maxScore    Float     @default(100)
  fileUrl     String?
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  class       Class     @relation(fields: [classId], references: [id])
  teacher     User      @relation(fields: [teacherId], references: [id])
  submissions Submission[]

  @@map("assignments")
}

model Submission {
  id           String    @id @default(cuid())
  assignmentId String
  studentId    String
  content      String?
  fileUrl      String?
  score        Float?
  feedback     String?
  submittedAt  DateTime  @default(now())
  gradedAt     DateTime?

  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  student      User       @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  @@map("submissions")
}

// ============================
// UJIAN ONLINE
// ============================

model Exam {
  id              String    @id @default(cuid())
  title           String
  description     String?
  classId         String?
  eventId         String?
  materialId      String?
  duration        Int
  startTime       DateTime?
  endTime         DateTime?
  isRandomized    Boolean   @default(false)
  shuffleOptions  Boolean   @default(false)
  passingScore    Float     @default(60)
  maxAttempts     Int       @default(1)
  scoringMode     String    @default("SUM")
  isPublished     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  class           Class?    @relation(fields: [classId], references: [id])
  event           Event?    @relation(fields: [eventId], references: [id])
  material        Material? @relation(fields: [materialId], references: [id])
  questions       Question[]
  examQuestions   ExamQuestion[]
  attempts        ExamAttempt[]
  sections        ExamSection[]
  questionGroups  QuestionGroup[]

  @@map("exams")
}

model Question {
  id            String       @id @default(cuid())
  examId        String?
  subjectId     String?
  groupId       String?
  sectionId     String?
  type          QuestionType @default(PILGAN)
  content       String
  imageUrl      String?
  audioUrl      String?
  videoUrl      String?
  options       Json?
  correctAnswer String?
  explanation   String?
  score         Float        @default(1)
  difficulty    Int          @default(2)
  tags          Json?
  order         Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  exam          Exam?        @relation(fields: [examId], references: [id])
  subject       Subject?     @relation(fields: [subjectId], references: [id])
  group         QuestionGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  section       ExamSection?   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  examQuestions ExamQuestion[]

  @@index([groupId])
  @@index([sectionId])
  @@index([subjectId])
  @@index([examId])
  @@map("questions")
}

model ExamQuestion {
  id         String   @id @default(cuid())
  examId     String
  questionId String
  order      Int      @default(0)
  score      Float?   @default(1)
  createdAt  DateTime @default(now())

  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([examId, questionId])
  @@index([questionId])
  @@map("exam_questions")
}

model ExamAttempt {
  id             String    @id @default(cuid())
  examId         String
  studentId      String
  attemptNumber  Int       @default(1)
  startedAt      DateTime  @default(now())
  submittedAt    DateTime?
  score          Float?
  answers        Json?
  isCompleted    Boolean   @default(false)
  sectionStates  Json?

  exam           Exam      @relation(fields: [examId], references: [id])
  student        User      @relation(fields: [studentId], references: [id])

  @@unique([examId, studentId, attemptNumber])
  @@map("exam_attempts")
}

model ExamSection {
  id        String   @id @default(cuid())
  examId    String
  name      String
  duration  Int
  order     Int      @default(0)
  createdAt DateTime @default(now())

  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([examId])
  @@map("exam_sections")
}

model QuestionGroup {
  id           String       @id @default(cuid())
  examId       String
  type         StimulusType
  title        String?
  passageText  String?      @db.Text
  audioUrl     String?
  maxPlayCount Int?
  timeLimit    Int?
  order        Int          @default(0)
  createdAt    DateTime     @default(now())

  exam         Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions    Question[]

  @@index([examId])
  @@map("question_groups")
}

// ============================
// ABSENSI
// ============================

model Attendance {
  id         String    @id @default(cuid())
  classId    String
  scheduleId String?
  date       DateTime
  createdAt  DateTime  @default(now())

  class      Class     @relation(fields: [classId], references: [id])
  schedule   Schedule? @relation(fields: [scheduleId], references: [id])
  records    AttendanceRecord[]

  @@unique([classId, date])
  @@map("attendances")
}

model AttendanceRecord {
  id           String           @id @default(cuid())
  attendanceId String
  studentId    String
  status       AttendanceStatus @default(HADIR)
  note         String?
  createdAt    DateTime         @default(now())

  attendance   Attendance @relation(fields: [attendanceId], references: [id])
  student      User       @relation(fields: [studentId], references: [id])

  @@unique([attendanceId, studentId])
  @@map("attendance_records")
}

// ============================
// ABSENSI TUTOR & PAYROLL
// ============================

enum TeacherAttendanceStatus {
  HADIR
  TERLAMBAT
  TIDAK_HADIR
  IZIN
  SAKIT
}

model TeacherAttendance {
  id          String                 @id @default(cuid())
  teacherId   String
  classId     String?
  scheduleId  String?
  branchId    String?
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  status      TeacherAttendanceStatus @default(HADIR)
  method      String?
  note        String?
  verifiedAt  DateTime?
  verifiedBy  String?
  createdAt   DateTime               @default(now())

  teacher     User                   @relation(fields: [teacherId], references: [id])
  class       Class?                 @relation(fields: [classId], references: [id])
  schedule    Schedule?              @relation(fields: [scheduleId], references: [id])
  branch      Branch?                @relation(fields: [branchId], references: [id])
  verifier    User?                  @relation("AttendanceVerifier", fields: [verifiedBy], references: [id])

  @@unique([teacherId, date])
  @@index([teacherId])
  @@index([branchId])
  @@map("teacher_attendances")
}

model TeacherPayroll {
  id              String    @id @default(cuid())
  teacherId       String
  branchId        String?
  periodId        String?
  periodStart     DateTime
  periodEnd       DateTime
  ratePerMeeting  Float     @default(0)
  ratePerHour     Float     @default(0)
  totalMeetings   Int       @default(0)
  totalHours      Float     @default(0)
  totalAmount     Float     @default(0)
  status          String    @default("DRAFT")
  approvedBy      String?
  approvedAt      DateTime?
  paidAt          DateTime?
  note            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  teacher         User      @relation(fields: [teacherId], references: [id])
  branch          Branch?   @relation(fields: [branchId], references: [id])
  period          ReportPeriod? @relation(fields: [periodId], references: [id])
  approver        User?     @relation("ApprovedPayrolls", fields: [approvedBy], references: [id])

  @@index([teacherId])
  @@index([branchId])
  @@index([status])
  @@map("teacher_payrolls")
}

// ============================
// NILAI
// ============================

model GradeComponent {
  id       String  @id @default(cuid())
  classId  String
  name     String
  weight   Float   @default(1)
  period   String?
  order    Int     @default(0)

  class    Class   @relation(fields: [classId], references: [id])
  grades   Grade[]

  @@map("grade_components")
}

model Grade {
  id          String         @id @default(cuid())
  studentId   String
  componentId String
  score       Float
  note        String?
  isLocked    Boolean        @default(false)
  lockedBy    String?
  lockedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  student     User           @relation(fields: [studentId], references: [id])
  component   GradeComponent @relation(fields: [componentId], references: [id])

  @@unique([studentId, componentId])
  @@map("grades")
}

model Raport {
  id             String   @id @default(cuid())
  studentId      String
  classId        String
  academicYearId String?
  branchId       String?
  semester       String   @default("GANJIL")
  period         String?
  periodId       String?
  finalGrade     Float?
  predicate      String?
  description    String?
  teacherNote    String?
  principalNote  String?
  attendanceSummary Json?
  gradeBreakdown Json?
  academicStars       Int?
  academicCategory    String?
  academicDescription String?
  attitudeStars       Int?
  attitudeCategory    String?
  attitudeDescription String?
  attitudeNote        String?
  status         String   @default("DRAFT")
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student        User     @relation(fields: [studentId], references: [id])
  class          Class    @relation(fields: [classId], references: [id])
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])

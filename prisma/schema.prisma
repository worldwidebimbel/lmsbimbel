// ============================
// EVENT BERBAYAR
// ============================

enum CertificateType {
  LMS_COMPLETION
  EVENT_PARTICIPATION
  EVENT_WINNER
}

enum EventType {
  TRYOUT
  OLIMPIADE
  WORKSHOP
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
}

enum EventRegistrationStatus {
  PENDING
  CONFIRMED
  ATTENDED
  CANCELLED
}

enum EventPaymentStatus {
  FREE
  PENDING
  PAID
  CANCELLED
}

model Event {
  id                   String        @id @default(cuid())
  branchId             String
  title                String
  description          String?
  type                 EventType     @default(TRYOUT)
  status               EventStatus   @default(DRAFT)
  startDate            DateTime
  endDate              DateTime?
  registrationDeadline DateTime?
  location             String?
  image                String?
  maxParticipants      Int?
  isPaid               Boolean       @default(false)
  rankingCriteria      Json?
  autoRanking          Boolean       @default(false)
  createdBy            String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  branch        Branch              @relation(fields: [branchId], references: [id])
  creator       User                @relation(fields: [createdBy], references: [id])
  packages      EventPackage[]
  registrations EventRegistration[]
  exams         Exam[]

  @@map("events")
  @@index([branchId])
  @@index([status])
}

model EventPackage {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  price       Float    @default(0)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event         Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]

  @@map("event_packages")
}

model EventRegistration {
  id             String                  @id @default(cuid())
  eventId        String
  userId         String
  packageId      String?
  status         EventRegistrationStatus @default(PENDING)
  paymentStatus  EventPaymentStatus      @default(FREE)
  price          Float                   @default(0)
  paymentMethod  String?
  paymentToken   String?
  externalId     String?
  paymentProofUrl String?
  paidAt         DateTime?
  registeredAt   DateTime                @default(now())
  attendedAt     DateTime?
  score          Float?
  rank           Int?
  certificateUrl String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id])
  package   EventPackage? @relation(fields: [packageId], references: [id])

  @@unique([eventId, userId])
  @@map("event_registrations")
  @@index([eventId])
  @@index([userId])
}

